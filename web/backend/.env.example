# Export these variables, or copy to .env and use ./run-local.ps1 (Spring itself does not load .env).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartbox
SPRING_DATASOURCE_USERNAME=smartbox
SPRING_DATASOURCE_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_HMAC_SECRET=
PAYMENT_PROVIDER=mock
VNPAY_ENVIRONMENT=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5174/payments/vnpay/return
SMARTBOX_JOBS_ENABLED=false
BACKEND_PUBLIC_URL=http://localhost:8080
SHOP_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Mailpit local. Gmail: smtp.gmail.com / 587, SMTP_AUTH=true, SMTP_STARTTLS=true.
MAIL_ENABLED=false
MAIL_SENDER_ADDRESS=
MAIL_SENDER_NAME=SmartBox
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MQTT_ENABLED=false
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SUBSCRIPTIONS=delivery_box/+/status,delivery_box/+/sensor,delivery_box/+/ack
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
REPORT_FONT_PATH=C:/Windows/Fonts/arial.ttf
INSTALLATION_FRESHNESS_SECONDS=90
INSTALLATION_WEIGHT_MIN_DELTA_KG=0.05
INSTALLATION_TARE_TOLERANCE_KG=0.05
WARRANTY_DEFAULT_MONTHS=12

# Warranty claim image uploads (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Merchant details displayed on new sales invoices; never invent a tax code.
INVOICE_SHOP_NAME=SmartBox
INVOICE_SHOP_ADDRESS=
INVOICE_SHOP_PHONE=
INVOICE_SHOP_EMAIL=
INVOICE_SHOP_WEBSITE=
INVOICE_SHOP_TAX_CODE=
