# ==============================================================================
# 1. DATABASE & SUPABASE CONFIGURATION
# ==============================================================================
# Supabase Remote (Singapore Cloud Database):
SPRING_DATASOURCE_URL=jdbc:postgresql://<supabase-pooler-host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<supabase-project-ref>
SPRING_DATASOURCE_PASSWORD=<supabase-db-password>
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# Hoặc PostgreSQL Local Docker Compose (nếu chạy local docker-compose.yml):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartbox
# SPRING_DATASOURCE_USERNAME=smartbox
# SPRING_DATASOURCE_PASSWORD=smartbox_secret_password

SUPABASE_URL=https://<supabase-project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>


# ==============================================================================
# 2. SYSTEM URLS, CORS & BACKGROUND JOBS
# ==============================================================================
BACKEND_PUBLIC_URL=http://localhost:8080
SHOP_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SMARTBOX_JOBS_ENABLED=true


# ==============================================================================
# 3. EMAIL & SMTP CONFIGURATION (GMAIL)
# ==============================================================================
MAIL_ENABLED=true
MAIL_SENDER_ADDRESS=<your-email@gmail.com>
MAIL_SENDER_NAME=ANCHOR_BOX SERVICE
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<your-email@gmail.com>
SPRING_MAIL_PASSWORD=<gmail-app-password>
SMTP_AUTH=true
SMTP_STARTTLS=true

# Hoặc Mailpit Local Docker:
# MAIL_ENABLED=false
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# SMTP_AUTH=false
# SMTP_STARTTLS=false


# ==============================================================================
# 4. PAYMENT & VNPAY GATEWAY
# ==============================================================================
PAYMENT_PROVIDER=vnpay
PAYMENT_HMAC_SECRET=<random-32-byte-secret>
PAYMENT_TIMEOUT_MINUTES=15

VNPAY_ENVIRONMENT=sandbox
VNPAY_TMN_CODE=<vnpay-tmn-code>
VNPAY_HASH_SECRET=<vnpay-hash-secret>
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return


# ==============================================================================
# 5. REDIS CONFIGURATION (UPSTASH CLOUD)
# ==============================================================================
REDIS_HOST=<your-upstash-host>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<upstash-redis-password>
REDIS_DATABASE=0
REDIS_SSL=true
REDIS_AUTH_ENABLED=true

# Hoặc Redis Local Docker:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DATABASE=0
# REDIS_SSL=false
# REDIS_AUTH_ENABLED=false


# ==============================================================================
# 6. IOT / MQTT & HARDWARE INSTALLATION
# ==============================================================================
MQTT_ENABLED=false
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SUBSCRIPTIONS=delivery_box/+/status,delivery_box/+/sensor,delivery_box/+/ack

INSTALLATION_FRESHNESS_SECONDS=90
INSTALLATION_WEIGHT_MIN_DELTA_KG=0.05
INSTALLATION_TARE_TOLERANCE_KG=0.05
WARRANTY_DEFAULT_MONTHS=12


# ==============================================================================
# 7. THIRD-PARTY SERVICES (CLOUDINARY & FIREBASE FCM)
# ==============================================================================
# Warranty claim image uploads (server only)
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
REPORT_FONT_PATH=C:/Windows/Fonts/arial.ttf


# ==============================================================================
# 8. SALES INVOICE MERCHANT DETAILS
# ==============================================================================
INVOICE_SHOP_NAME=SmartBox
INVOICE_SHOP_ADDRESS=12 Chùa Bộc, Quang Trung, Đống Đa, Hà Nội
INVOICE_SHOP_PHONE=1900 6868
INVOICE_SHOP_EMAIL=contact@smartbox.vn
INVOICE_SHOP_WEBSITE=https://smartbox.vn
INVOICE_SHOP_TAX_CODE=0101234567
