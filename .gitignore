# --- Secrets / machine-specific config (never commit) ---
**/.env
**/local.properties
*.bak_old_project
device/firmware/include/device_secrets.h
app/lib/core/constants/supabase_config.dart
app/supabase/.temp/

# --- Build outputs & logs ---
.pio
**/.pio/
node_modules/
device/firmware/build_log.txt
app/android/build/

# --- Local snapshots and legacy material kept off the repo ---
_firmware_baseline_*/
device/firmware/backups/
device/firmware/recovery_backup_*/
# Root-level only: the legacy Express backend, Docker stack, docs and
# database scripts. web/backend (Spring Boot) is tracked.
/backend/
/docker/
/docs/
/database/

# --- Editors and tools ---
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.playwright-mcp/

# --- Altium auto-generated history and previews ---
device/pcb/History/
**/__Previews/
