<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: the app's Apple Home style wallpaper, a light scrim and
     the white anchor mark, matching the Flutter onboarding screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_wallpaper" />
    </item>
    <item android:drawable="@color/splash_scrim" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
